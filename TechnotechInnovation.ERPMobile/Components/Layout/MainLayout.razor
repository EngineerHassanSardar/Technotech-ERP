@inherits LayoutComponentBase
@using MudBlazor

<MudLayout Style="height: 100vh; background-color: #f8fafc;">

    <!-- Top Bar -->
    <MudAppBar Elevation="0" Class="premium-app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@((e) => DrawerToggle())" />

        <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold">
            Technotech ERP
        </MudText>

        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
    </MudAppBar>

    <!-- Side Menu -->
    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="16"
               Variant="@DrawerVariant.Temporary"
               Width="280px"
               Style="background-color: #ffffff; z-index: 1400;">
        <NavMenu />
    </MudDrawer>

    <!-- Main Content: pt-16 gives exact space for the App Bar -->
    <MudMainContent Class="pt-16 px-4" Style="height: 100vh; overflow-y: auto; padding-bottom: 60px;">
        @Body
    </MudMainContent>

</MudLayout>

@code {
    bool _drawerOpen = false;
    void DrawerToggle() => _drawerOpen = !_drawerOpen;
}