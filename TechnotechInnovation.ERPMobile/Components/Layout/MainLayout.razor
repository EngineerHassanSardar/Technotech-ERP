@inherits LayoutComponentBase
@using MudBlazor

<MudLayout Style="height: 100vh; background-color: #f8fafc;">
    <!-- Top Bar -->
    <MudAppBar Elevation="0" Class="premium-app-bar" Fixed="true" Style="z-index: 1300;">
        
        <!-- 3 Lines Menu Button -->
        <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                       Color="Color.Inherit" 
                       Edge="Edge.Start" 
                       OnClick="@((e) => DrawerToggle())" />
        
        <MudText Typo="Typo.h6" Class="ml-2 font-weight-bold" Style="letter-spacing: -0.5px;">
            Technotech ERP
        </MudText>
        
        <MudSpacer />
        
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
    </MudAppBar>

    <!-- Side Menu -->
    <MudDrawer @bind-Open="_drawerOpen" 
               Elevation="4" 
               Variant="@DrawerVariant.Temporary" 
               Width="280px"
               Style="z-index: 1400;">
        <NavMenu />
    </MudDrawer>

    <!-- Content Area -->
    <MudMainContent Class="px-4" Style="padding-top: 80px; height: 100vh; overflow-y: auto;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = false;
    void DrawerToggle() => _drawerOpen = !_drawerOpen;
}